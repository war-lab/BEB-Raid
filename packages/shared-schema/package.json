{
  "name": "@beb-raid/shared-schema",
  "private": true,
  "version": "0.1.0",
  "description": "問題パックJSON・manifest のスキーマ型とバリデータ（app と cli で共有）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}
