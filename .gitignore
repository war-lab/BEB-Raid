# 依存
node_modules/

# ビルド成果物
dist/
packages/app/dev-dist/
*.tsbuildinfo

# カバレッジレポート（T-286。npm run test:coverageの出力）
coverage/

# ローカル環境変数（LLM/TTSキーは環境変数のみ。リポジトリに含めない）
.env
.env.*
# .env.exampleは実値を含まない雛形なのでコミット対象にする（T-96）
!.env.example

# Cloudflare Workers ローカル開発の秘密値（招待コード等。packages/api/.dev.vars.example を参照）
packages/api/.dev.vars
# wrangler ローカル実行時の作業ディレクトリ
packages/api/.wrangler/

# エディタ・OS
.DS_Store
Thumbs.db
*.log

# Playwright MCP の作業ファイル
.playwright-mcp/

# 市販教材（TOEIC公式問題集等）の音声・素材。著作権上リポジトリに含めない（01のR-1）
/toeic_test_1_album_1/
/all_toeic_official_lr_11_test_1_album_1/
# 公式TOEIC問題集からの参考問題データ（コンテンツ作成時の形式・難易度の参考用。
# 実問題文・選択肢を含むため丸ごとコピー厳禁＝著作権上リポジトリに含めない）
/toeic*_test*_*.json

# Piperボイスモデル（TTS生成のローカル依存。数十MB/ファイルのためリポジトリに含めない。
# 導入: pip install piper-tts && python -m piper.download_voices <voice> --download-dir .piper-voices）
/.piper-voices/


# 実機確認の一時スクリーンショット（記録として残すものは docs/dogfood/ 配下へ移す。30のJ-112）
/*.jpeg
/*.jpg
